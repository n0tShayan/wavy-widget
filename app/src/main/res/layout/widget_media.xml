<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout: only framework widget classes allowed (no Space/View/custom views).

     Every animation here runs inside the launcher and costs this app nothing:
     - animateLayoutChanges stacks hold two copies (a / b) of the art, text and colours. On a
       track change the app flips which copy is visible and the launcher crossfades them.
     - Indeterminate ProgressBars start their AnimatedVectorDrawable on the RenderThread as
       soon as they become visible: the wave, its grow / shrink, and the play / pause morph.
     - stateListAnimator gives the buttons a press dip and spring on touch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Album art with the track info overlaid, One UI 9 style. -->
    <FrameLayout
        android:id="@+id/art_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- bg_a always shows; bg_b fades in over it, or out to reveal it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true">

            <ImageView
                android:id="@+id/bg_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/bg_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:importantForAccessibility="no" />

        <!-- Exactly one of text_a / text_b is visible: old text fades out, new fades in. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:animateLayoutChanges="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:id="@+id/text_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_a"
                    style="@style/WidgetTitle" />

                <TextView
                    android:id="@+id/artist_a"
                    style="@style/WidgetArtist" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/text_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/title_b"
                    style="@style/WidgetTitle" />

                <TextView
                    android:id="@+id/artist_b"
                    style="@style/WidgetArtist" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Fixed-colour panel: the wave mask relies on this exact colour. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="wrap_content">

                <!-- Ticks inside the launcher itself while playing: no app wake-ups. -->
                <Chronometer
                    android:id="@+id/elapsed_live"
                    style="@style/WidgetTime" />

                <TextView
                    android:id="@+id/elapsed_static"
                    style="@style/WidgetTime" />
            </FrameLayout>

            <!-- Seek bar, bottom to top: colour fill, wave mask (animated wave while playing,
                 its shrink for a moment on pause, a static flat mask once paused), a fade at
                 the start, the cover that hides the unplayed part, then the handle. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:animateLayoutChanges="true">

                    <ImageView
                        android:id="@+id/fill_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />

                    <ImageView
                        android:id="@+id/fill_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:visibility="gone" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/seek_wave"
                    style="@style/WidgetWave"
                    android:indeterminateDrawable="@drawable/seek_wave_grow"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/seek_shrink"
                    style="@style/WidgetWave"
                    android:indeterminateDrawable="@drawable/seek_wave_shrink"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/seek_flat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/seek_flat_mask" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/seek_fade" />

                <ImageView
                    android:id="@+id/seek_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/seek_cover" />

                <ImageView
                    android:id="@+id/seek_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/seek_thumb" />
            </FrameLayout>

            <TextView
                android:id="@+id/duration"
                style="@style/WidgetTime"
                android:layout_width="38dp"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_soft"
                android:contentDescription="Previous"
                android:foreground="@drawable/ripple_circle"
                android:stateListAnimator="@animator/press_scale">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_play"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:contentDescription="Play or pause"
                android:foreground="@drawable/ripple_circle"
                android:stateListAnimator="@animator/press_scale">

                <!-- Tinted with the album colour via setColorFilter; crossfades with the art. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:animateLayoutChanges="true">

                    <ImageView
                        android:id="@+id/play_bg_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/circle_solid" />

                    <ImageView
                        android:id="@+id/play_bg_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/circle_solid"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/play_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />

                <ProgressBar
                    android:id="@+id/icon_to_pause"
                    style="@style/WidgetMorph"
                    android:indeterminateDrawable="@drawable/avd_play_to_pause" />

                <ProgressBar
                    android:id="@+id/icon_to_play"
                    style="@style/WidgetMorph"
                    android:indeterminateDrawable="@drawable/avd_pause_to_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_soft"
                android:contentDescription="Next"
                android:foreground="@drawable/ripple_circle"
                android:stateListAnimator="@animator/press_scale">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
